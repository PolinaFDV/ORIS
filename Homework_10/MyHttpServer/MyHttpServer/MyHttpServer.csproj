<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

	<ItemGroup>
		<Content Include="static\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	

	<ItemGroup>
	  <Folder Include="Framework\Configuration\" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Templates\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
	<ItemGroup>
  		<ProjectReference Include="..\MiniHttpServer.ORM\MiniHttpServer.ORM.csproj" />
  		<ProjectReference Include="..\MiniTemplateEngine\MiniTemplateEngine.csproj" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="Npgsql" Version="10.0.3" />
	</ItemGroup>

</Project>
